    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "pino": "10.3.1",
    "qrcode-terminal": "^0.12.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.1.0",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
