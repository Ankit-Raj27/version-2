{
  "name": "personal-ai",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @personal-ai/server --filter @personal-ai/dashboard run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "db:generate": "pnpm --filter @personal-ai/server run db:generate",
    "db:migrate": "pnpm --filter @personal-ai/server run db:migrate",
    "db:studio": "pnpm --filter @personal-ai/server run db:studio",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm db:migrate"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14"
  }
}
