NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
DASHBOARD_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SERVER_BASE_URL=http://127.0.0.1:3001
DATABASE_URL=./data/personal-ai.db
LOG_LEVEL=info
WHATSAPP_ENABLED=true

# Relative to apps/server when launched through the workspace.
WHATSAPP_AUTH_DIR=../../data/whatsapp-auth

# true = absolutely no outgoing WhatsApp messages
WHATSAPP_KILL_SWITCH=true
