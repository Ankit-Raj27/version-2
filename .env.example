NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
DASHBOARD_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SERVER_BASE_URL=http://127.0.0.1:3001
DATABASE_URL=./data/personal-ai.db
LOG_LEVEL=info
WHATSAPP_ENABLED=true

# Relative to apps/server when launched through the workspace.
WHATSAPP_AUTH_DIR=../../data/whatsapp-auth

# true = absolutely no outgoing WhatsApp messages
WHATSAPP_KILL_SWITCH=true

# --- Phase 4: AI drafting ---
# false = no AI calls happen at all. Safe default OFF, like WHATSAPP_KILL_SWITCH.
AI_DRAFTING_ENABLED=false
# Required only when AI_DRAFTING_ENABLED=true. Never commit a real key.
AI_API_KEY=
# Any provider with an OpenAI-compatible chat completions endpoint works here —
# verified against Meta's Model API, OpenAI itself, and Google's Gemini compat
# layer. AI_API_BASE_URL, AI_MODEL, and the key must all come from the SAME
# provider (mixing them fails with a 401/404, not a clear "wrong provider" error).
AI_API_BASE_URL=https://api.openai.com/v1
# Do NOT use a Meta "*-contributor" model id if you switch back to Meta: Meta
# may train on your messages under that tier. env.ts rejects it outright.
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=512
AI_TEMPERATURE=0.6
# Leave empty for models/providers that reject an unrecognized reasoning_effort param
# (e.g. most non-reasoning OpenAI chat models).
AI_REASONING_EFFORT=minimal
# Clamped to 10..30.
AI_CONTEXT_MESSAGE_LIMIT=20
# Optional CSV allowlist of WhatsApp JIDs eligible for drafting. Empty = all direct conversations.
AI_DRAFT_ALLOWED_JIDS=
